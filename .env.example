# Supabase Configuration
# Obtener estas credenciales desde: https://supabase.com/dashboard/project/_/settings/api
# Nuevas claves API (recomendado):
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Claves legacy (tambien soportadas, pero no recomendadas):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# URL del frontend para compartir carritos
# En produccion (Vercel), usa tu dominio personalizado o la URL de Vercel
# Ejemplo: https://pescamania-flyfishing-a41ovijct-matias-projects-224d9654.vercel.app
# O si tienes dominio: https://tudominio.com
NEXT_PUBLIC_FRONTEND_URL=https://pescamania-flyfishing-a41ovijct-matias-projects-224d9654.vercel.app

# Numero de WhatsApp (opcional, tambien se puede configurar desde el admin)
NEXT_PUBLIC_WHATSAPP_NUMBER=1234567890
